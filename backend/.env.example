# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=/var/lib/app/reports.db

# Security
API_KEY=your-secret-key-here
SESSION_SECRET=another-secret-key

# Akamai (optional)
EDGERC_PATH=/opt/app/.edgerc
AKAMAI_HOST=diagnostic-tools.akamai.com

# Logging
LOG_LEVEL=info

# Rate limiting (per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Diagnostics timeouts (milliseconds)
DIG_TIMEOUT=10000
CURL_TIMEOUT=15000
MTR_TIMEOUT=60000
MTR_HOPS=30
